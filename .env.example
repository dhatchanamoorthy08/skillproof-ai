# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave blank to use built-in zero-config in-memory MongoDB during local dev
MONGODB_URI=mongodb://localhost:27017/skillproof_ai

# JWT Authentication (Set a strong 64-character random string in production)
JWT_SECRET=change_me_to_a_secure_random_hex_key_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# AI Service Configuration (Optional: system provides deterministic heuristic fallback if absent)
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
